an":{"span":{"file_id":2,"beg":{"line":122,"col":0},"end":{"line":122,"col":29}},"generated_from_span":null},"source_text":"const CHUNK_SIZE: usize = 64;","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Transparent"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"ty":{"Literal":{"Integer":"Usize"}},"kind":"Regular","init":35},{"def_id":2,"item_meta":{"name":[{"Ident":["fips_implementations",0]},{"Ident":["algorithms",0]},{"Ident":["sha1",0]},{"Ident":["K0",0]}],"span":{"span":{"file_id":2,"beg":{"line":125,"col":0},"end":{"line":125,"col":30}},"generated_from_span":null},"source_text":"const K0: u32 = 0x5A827999u32;","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Transparent"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"ty":{"Literal":{"Integer":"U32"}},"kind":"Regular","init":36},{"def_id":3,"item_meta":{"name":[{"Ident":["fips_implementations",0]},{"Ident":["algorithms",0]},{"Ident":["sha1",0]},{"Ident":["K1",0]}],"span":{"span":{"file_id":2,"beg":{"line":126,"col":0},"end":{"line":126,"col":30}},"generated_from_span":null},"source_text":"const K1: u32 = 0x6ED9EBA1u32;","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Transparent"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"ty":{"Literal":{"Integer":"U32"}},"kind":"Regular","init":37},{"def_id":4,"item_meta":{"name":[{"Ident":["fips_implementations",0]},{"Ident":["algorithms",0]},{"Ident":["sha1",0]},{"Ident":["K2",0]}],"span":{"span":{"file_id":2,"beg":{"line":127,"col":0},"end":{"line":127,"col":30}},"generated_from_span":null},"source_text":"const K2: u32 = 0x8F1